# Option 1: OAuth ("Connect Pinterest" button)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:4821/api/auth/callback

# Option 2: a ready-made access token (or paste it in the UI instead)
PINTEREST_ACCESS_TOKEN=

# Optional: use the sandbox API for Trial-access apps
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5

